# ── 搜尋設定 ──────────────────────────────────────────────────────────────────
# 關鍵字（逗號分隔，支援 AND / OR / NOT，例如：資訊系統,軟體開發）
KEYWORDS=資訊系統,軟體開發

# 標案種類：招標 / 決標 / 公開閱覽及公開徵求 / 政府採購預告
TENDER_STATUS_TYPE=招標

# 每個關鍵字最多抓幾頁（100 筆/頁）
MAX_PAGES=3

# 僅通知幾天內的新標案（0 = 不過濾日期，全部通知）
NOTIFY_DAYS=3

# ── 排程設定 ──────────────────────────────────────────────────────────────────
# 每天幾點幾分執行（24h 制）
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0

# ── 資料庫 ────────────────────────────────────────────────────────────────────
DB_PATH=tenders.db

# ── Google OAuth2（推薦，適用個人 Gmail）────────────────────────────────────
# 執行 python tools/get_google_token.py 取得以下三個值
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Google Sheets 試算表 ID（從 URL 取得）
# https://docs.google.com/spreadsheets/d/<這裡>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=標案通知

# ── Email 通知（使用 Gmail 請開啟應用程式密碼）────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=標案通知系統 <your@gmail.com>
EMAIL_TO=recipient@example.com
